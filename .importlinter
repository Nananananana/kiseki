[importlinter]
include_external_packages = True
root_packages =
    kiseki
    kiseki_ingest
    kiseki_notes
    kiseki_web

[importlinter:contract:layers]
name = Layer dependency direction
type = layers
layers =
    kiseki.interfaces
    kiseki.config
    kiseki.adapters
    kiseki.application
    kiseki.ports
    kiseki.domain
exhaustive = false

[importlinter:contract:domain-purity]
name = Domain layer must not depend on external libraries
type = forbidden
source_modules =
    kiseki.domain
forbidden_modules =
    httpx
    numpy
    PIL
    jsonschema

[importlinter:contract:domain-no-io]
name = Domain layer must not touch the filesystem
type = forbidden
source_modules =
    kiseki.domain
forbidden_modules =
    pathlib
    os
    tomllib
    kiseki.config

[importlinter:contract:notes-independence]
name = Notes producer must not depend on core domain or application
type = forbidden
source_modules =
    kiseki_notes
forbidden_modules =
    kiseki.domain.interests
    kiseki.domain.photo
    kiseki.domain.note
    kiseki.application
    kiseki.adapters

[importlinter:contract:ingest-independence]
name = Ingest implementation must not depend on core domain
type = forbidden
source_modules =
    kiseki_ingest
forbidden_modules =
    kiseki.domain
    kiseki.application

[importlinter:contract:web-independence]
name = Web producer must not depend on core domain or application
type = forbidden
source_modules =
    kiseki_web
forbidden_modules =
    kiseki.domain
    kiseki.application
    kiseki.adapters

[importlinter]
root_packages =
    kiseki
    kiseki_ingest

[importlinter:contract:layers]
name = Layer dependency direction
type = layers
layers =
    kiseki.config
    kiseki.adapters
    kiseki.application
    kiseki.ports
    kiseki.domain
exhaustive = false

[importlinter:contract:domain-purity]
name = Domain layer must not depend on external libraries
type = forbidden
source_modules =
    kiseki.domain
forbidden_modules =
    httpx
    numpy
    PIL
    jsonschema

[importlinter:contract:domain-no-io]
name = Domain layer must not touch the filesystem
type = forbidden
source_modules =
    kiseki.domain
forbidden_modules =
    pathlib
    os
    tomllib
    sqlite3
    kiseki.config

[importlinter:contract:ingest-independence]
name = Ingest implementation must not depend on core domain
type = forbidden
source_modules =
    kiseki_ingest
forbidden_modules =
    kiseki.domain
    kiseki.application

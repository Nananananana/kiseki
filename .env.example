# Base directory for all data. Defaults to ~/.kiseki when unset.
KISEKI_DATA_ROOT=

# Override individual paths to separate bulk storage from fast storage.
KISEKI_DB_PATH=
KISEKI_INDEX_DIR=
KISEKI_LOG_DIR=

# Set to true to reject any adapter that performs network access.
KISEKI_OFFLINE=false

# Blur coordinates in exports and visualizations.
KISEKI_BLUR_COORDINATES=true

KISEKI_LOG_LEVEL=INFO
